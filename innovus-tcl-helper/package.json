{
    "name": "innovus-tcl-enhance",
    "displayName": "Innovus TCL Enhance",
    "description": "%extension.description%",
    "version": "0.6.4",
    "publisher": "fd-echoro",
    "icon": "icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/echo-edai/innovus-tcl-helper"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "activationEvents": [
        "onLanguage:tcl"
    ],
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "keywords": [
        "tcl",
        "innovus",
        "cadence",
        "eda",
        "semiconductor"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "innovus-tcl.reloadDB",
                "title": "%command.reloadDB.title%"
            },
            {
                "command": "innovus-tcl.showHelp",
                "title": "%command.showHelp.title%"
            },
            {
                "command": "innovus-tcl.switchLanguage",
                "title": "%command.switchLanguage.title%"
            },
            {
                "command": "innovus-tcl.toggleHelpStyle",
                "title": "%command.toggleHelpStyle.title%"
            },
            {
                "command": "innovus-tcl.analyzeScript",
                "title": "%command.analyzeScript.title%"
            },
            {
                "command": "innovus-tcl.listCommands",
                "title": "%command.listCommands.title%"
            },
            {
                "command": "innovus-tcl.switchVersion",
                "title": "%command.switchVersion.title%"
            },
            {
                "command": "innovus-tcl.installMcp",
                "title": "%command.installMcp.title%"
            },
            {
                "command": "innovus-tcl.installSkills",
                "title": "%command.installSkills.title%"
            },
            {
                "command": "innovus-tcl.editPrompt",
                "title": "%command.editPrompt.title%"
            },
            {
                "command": "innovus-tcl.openExample",
                "title": "%command.openExample.title%"
            },
            {
                "command": "innovus-tcl.runLint",
                "title": "%command.runLint.title%"
            },
            {
                "command": "innovus-tcl.showLintReport",
                "title": "%command.showLintReport.title%"
            },
            {
                "command": "innovus-tcl.openFFile",
                "title": "%command.openFFile.title%"
            },
            {
                "command": "innovus-tcl.setFFile",
                "title": "%command.setFFile.title%"
            },
            {
                "command": "innovus-tcl.runScript",
                "title": "%command.runScript.title%",
                "icon": "$(play)"
            },
            {
                "command": "innovus-tcl.runProject",
                "title": "%command.runProject.title%",
                "icon": "$(run-all)"
            }
        ],
        "configuration": {
            "title": "Innovus TCL Helper",
            "properties": {
                "innovus-tcl.language": {
                    "type": "string",
                    "default": "en",
                    "enum": [
                        "en",
                        "zh",
                        "auto"
                    ],
                    "enumDescriptions": [
                        "%config.language.enum0%",
                        "%config.language.enum1%",
                        "%config.language.enum2%"
                    ],
                    "description": "%config.language.description%"
                },
                "innovus-tcl.version": {
                    "type": "string",
                    "default": "25.1",
                    "description": "%config.version.description%"
                },
                "innovus-tcl.versions": {
                    "type": "array",
                    "default": [],
                    "description": "%config.versions.description%"
                },
                "innovus-tcl.enableAITools": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableAITools.description%"
                },
                "innovus-tcl.enableDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableDiagnostics.description%"
                },
                "innovus-tcl.enableCompilation": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableCompilation.description%"
                },
                "innovus-tcl.fFile": {
                    "type": "string",
                    "default": "tcl.f",
                    "description": "%config.fFile.description%"
                },
                "innovus-tcl.enableHover": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableHover.description%"
                },
                "innovus-tcl.enableCompletion": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableCompletion.description%"
                },
                "innovus-tcl.helpStyle": {
                    "type": "string",
                    "default": "webview",
                    "enum": [
                        "webview",
                        "plain"
                    ],
                    "enumDescriptions": [
                        "%config.helpStyle.enum0%",
                        "%config.helpStyle.enum1%"
                    ],
                    "description": "%config.helpStyle.description%"
                },
                "innovus-tcl.diagnosticLevel": {
                    "type": "string",
                    "default": "standard",
                    "enum": [
                        "basic",
                        "standard",
                        "strict"
                    ],
                    "enumDescriptions": [
                        "%config.diagnosticLevel.enum0%",
                        "%config.diagnosticLevel.enum1%",
                        "%config.diagnosticLevel.enum2%"
                    ],
                    "description": "%config.diagnosticLevel.description%"
                },
                "innovus-tcl.aiPrompt": {
                    "type": "string",
                    "default": "",
                    "description": "%config.aiPrompt.description%"
                },
                "innovus-tcl.tclshPath": {
                    "type": "string",
                    "default": "",
                    "description": "%config.tclshPath.description%"
                },
                "innovus-tcl.runSaveOutput": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.runSaveOutput.description%"
                },
                "innovus-tcl.runOutputDir": {
                    "type": "string",
                    "default": "",
                    "description": "%config.runOutputDir.description%"
                },
                "innovus-tcl.simOutputMode": {
                    "type": "string",
                    "default": "dry-run",
                    "enum": [
                        "dry-run",
                        "mkdir"
                    ],
                    "enumDescriptions": [
                        "%config.simOutputMode.enum0%",
                        "%config.simOutputMode.enum1%"
                    ],
                    "description": "%config.simOutputMode.description%"
                }
            }
        },
        "menus": {
            "editor/title": [
                {
                    "command": "innovus-tcl.runScript",
                    "when": "editorLangId == tcl",
                    "group": "navigation@1"
                },
                {
                    "command": "innovus-tcl.runProject",
                    "when": "editorLangId == tcl",
                    "group": "navigation@2"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "node scripts/prepublish.mjs && npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "prepublish": "node scripts/prepublish.mjs",
        "package": "node scripts/prepublish.mjs && npm run compile && mkdir -p publish && vsce package --allow-missing-repository --out publish/",
        "publish": "node scripts/prepublish.mjs && npm run compile && vsce publish --allow-missing-repository",
        "publish:check": "echo 'VSCE_PAT status:' && [ -n \"$VSCE_PAT\" ] && echo '✅ set' || echo '❌ not set - required: export VSCE_PAT=<your-pat>'",
        "lint": "eslint src --ext ts"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.90.0",
        "@vscode/vsce": "^3.9.2",
        "typescript": "^5.3.3"
    }
}
